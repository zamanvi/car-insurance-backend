# Backend Configuration for Multi-City Support

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/insurance-multi-city

# JWT
JWT_SECRET=your_super_secret_key_change_this_12345678901234

# CORS - Allow all city app frontends
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,https://nyc.yourapp.com,https://chicago.yourapp.com,https://dc.yourapp.com,https://boston.yourapp.com,https://la.yourapp.com,https://miami.yourapp.com

# Environment
NODE_ENV=production

# Default City (fallback if not specified)
DEFAULT_CITY=nyc

# Optional: API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
